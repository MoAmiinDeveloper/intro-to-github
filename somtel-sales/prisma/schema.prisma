// Somtel Enterprise Sales System
// Phase 1: access, settings, branding, clients and contacts, catalog.
// Later phases add pipeline, quotes, orders, renewals and reports.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// People and access
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  HEAD_OF_ENTERPRISE
  MANAGER
  ACCOUNT_MANAGER
  ENTERPRISE_SUPPORT
  PROCUREMENT
  FINANCE
  BILLING
  TECH
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  title        String?
  passwordHash String
  active       Boolean   @default(true)
  managerId    String?
  manager      User?     @relation("ReportingLine", fields: [managerId], references: [id])
  reports      User[]    @relation("ReportingLine")
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  roles         UserRole[]
  sectors       UserSector[]
  techSections  UserTechSection[]
  ownedClients  Client[]             @relation("ClientOwner")
  ownedGroups   ClientGroup[]        @relation("GroupOwner")
  ownedDeals    Deal[]               @relation("DealOwner")
  activities    Activity[]
  resetTokens   PasswordResetToken[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model UserRole {
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Sector {
  id        String        @id @default(cuid())
  name      String        @unique
  active    Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  users     UserSector[]
  clients   Client[]
  groups    ClientGroup[]
}

model UserSector {
  userId   String
  sectorId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector   Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([userId, sectorId])
}

model TechSection {
  id        String               @id @default(cuid())
  name      String               @unique
  email     String?
  active    Boolean              @default(true)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  users     UserTechSection[]
  services  ServiceTechSection[]
}

model UserTechSection {
  userId        String
  techSectionId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  techSection   TechSection @relation(fields: [techSectionId], references: [id], onDelete: Cascade)

  @@id([userId, techSectionId])
}

// ---------------------------------------------------------------------------
// Settings and reference lists
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model CompanyProfile {
  id         String   @id @default("company")
  name       String
  legalName  String?
  address    String?
  city       String?
  phone      String?
  email      String?
  website    String?
  footerText String?
  logoPath   String?
  updatedAt  DateTime @updatedAt
}

enum StageKind {
  OPEN
  WON
  LOST
}

model PipelineStage {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  probability Int
  kind        StageKind @default(OPEN)
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deals       Deal[]
}

model LostReason {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals     Deal[]
}

enum TermsCategory {
  IT_RESALE
  A2P_SMS
  IVR
  TRACKING
  GENERAL
}

model TermsTemplate {
  id        String        @id @default(cuid())
  name      String        @unique
  category  TermsCategory
  body      String
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
}

enum ClauseCategory {
  PAYMENT
  SCOPE
  DELIVERY
  WARRANTY
  VALIDITY
  OTHER
}

model TermsClause {
  id        String         @id @default(cuid())
  category  ClauseCategory
  text      String
  sortOrder Int            @default(0)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

model ClientGroup {
  id          String    @id @default(cuid())
  name        String
  // Defaults copied to new entities in the group (each entity can change them).
  sectorId    String?
  sector      Sector?   @relation(fields: [sectorId], references: [id])
  ownerId     String?
  owner       User?     @relation("GroupOwner", fields: [ownerId], references: [id])
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  entities    Client[]

  @@index([name])
}

/// An entity: the legal company Somtel quotes, contracts and bills.
model Client {
  id            String              @id @default(cuid())
  name          String
  groupId       String?
  group         ClientGroup?        @relation(fields: [groupId], references: [id])
  sectorId      String?
  sector        Sector?             @relation(fields: [sectorId], references: [id])
  industry      String?
  address       String?
  city          String?
  phone         String?
  email         String?
  website       String?
  ownerId       String?
  owner         User?               @relation("ClientOwner", fields: [ownerId], references: [id])
  status        ClientStatus        @default(PROSPECT)
  notes         String?
  upsellNotes   String?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  contacts      Contact[]
  linkedPersons ContactEntityLink[]
  deals         Deal[]
  activities    Activity[]

  @@index([name])
  @@index([ownerId])
  @@index([sectorId])
  @@index([groupId])
}

/// A person. Belongs to one entity, and can also work with other entities in the same group.
model Contact {
  id              String              @id @default(cuid())
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id])
  otherEntities   ContactEntityLink[]
  name            String
  title           String?
  phone           String?
  email           String?
  isDecisionMaker Boolean             @default(false)
  notes           String?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@index([clientId])
}

model ContactEntityLink {
  contactId String
  clientId  String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([contactId, clientId])
}

// ---------------------------------------------------------------------------
// Somtel services catalog: Category -> Service -> Plan -> Price (on the plan)
// ---------------------------------------------------------------------------

enum ProductType {
  IT
  NON_IT
  TRACKING
}

enum PriceType {
  ONE_TIME
  MONTHLY
  PER_UNIT
  PER_MINUTE
  PER_SMS_TIERED
  MARGIN_PERCENT
}

enum BillingFrequency {
  ONE_TIME
  MONTHLY
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  enabled     Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  services    Service[]
}

model Service {
  id           String               @id @default(cuid())
  categoryId   String
  category     ServiceCategory      @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  // NON_IT (Somtel service) or TRACKING. IT resale items live in the IT catalog.
  productType  ProductType
  // Service shapes or options shown to sales (for example "Direct to one line").
  options      String[]
  active       Boolean              @default(true)
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  plans        Plan[]
  techSections ServiceTechSection[]

  @@unique([categoryId, name])
}

model ServiceTechSection {
  serviceId     String
  techSectionId String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  techSection   TechSection @relation(fields: [techSectionId], references: [id], onDelete: Cascade)

  @@id([serviceId, techSectionId])
}

model Plan {
  id               String           @id @default(cuid())
  serviceId        String
  service          Service          @relation(fields: [serviceId], references: [id])
  name             String
  description      String?
  priceType        PriceType
  billingFrequency BillingFrequency @default(ONE_TIME)
  // Catalog price in USD. Null for MARGIN_PERCENT (resale) and tiered plans.
  unitPrice        Decimal?         @db.Decimal(14, 4)
  unitLabel        String?
  includedUnits    Int?
  includedLabel    String?
  // Markup % for resale plans. Null means use the default in settings.
  marginPct        Decimal?         @db.Decimal(7, 3)
  active           Boolean          @default(true)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  tiers            PriceTier[]
  dealLines        DealProduct[]

  @@unique([serviceId, name])
}

model PriceTier {
  id        String  @id @default(cuid())
  planId    String
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  fromQty   Int
  // Null means no upper limit.
  toQty     Int?
  unitPrice Decimal @db.Decimal(14, 4)

  @@index([planId])
}

// ---------------------------------------------------------------------------
// Pipeline: deals, products of interest, activities, stage history
// ---------------------------------------------------------------------------

model Deal {
  id                String            @id @default(cuid())
  title             String
  clientId          String
  client            Client            @relation(fields: [clientId], references: [id])
  productType       ProductType
  stageId           String
  stage             PipelineStage     @relation(fields: [stageId], references: [id])
  // Win probability %. Copied from the stage when the deal moves; can be changed per deal.
  probability       Int
  // Estimated value, kept separate: one-time (setup, hardware, licences) and monthly (MRR).
  oneTimeValue      Decimal           @default(0) @db.Decimal(14, 2)
  monthlyValue      Decimal           @default(0) @db.Decimal(14, 2)
  expectedCloseDate DateTime?         @db.Date
  ownerId           String
  owner             User              @relation("DealOwner", fields: [ownerId], references: [id])
  nextStep          String?
  nextFollowUpAt    DateTime?         @db.Date
  lostReasonId      String?
  lostReason        LostReason?       @relation(fields: [lostReasonId], references: [id])
  lostNote          String?
  // Last call, meeting, email, note or stage change. Used for the stale flag.
  lastActivityAt    DateTime          @default(now())
  stageChangedAt    DateTime          @default(now())
  wonAt             DateTime?
  lostAt            DateTime?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  products          DealProduct[]
  activities        Activity[]
  stageChanges      DealStageChange[]

  @@index([ownerId])
  @@index([stageId])
  @@index([clientId])
  @@index([nextFollowUpAt])
}

/// A product the client is interested in. Values are estimates; the quote (Phase 3) sets real prices.
model DealProduct {
  id           String        @id @default(cuid())
  dealId       String
  deal         Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  planId       String?
  plan         Plan?         @relation(fields: [planId], references: [id])
  subProductId String?
  subProduct   ItSubProduct? @relation(fields: [subProductId], references: [id])
  description  String
  quantity     Decimal       @default(1) @db.Decimal(14, 2)
  oneTimeValue Decimal       @default(0) @db.Decimal(14, 2)
  monthlyValue Decimal       @default(0) @db.Decimal(14, 2)
  sortOrder    Int           @default(0)
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
  STAGE_CHANGE
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id])
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id])
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  occurredAt DateTime
  subject    String
  body       String?
  createdAt  DateTime     @default(now())
  deletedAt  DateTime?

  @@index([clientId, occurredAt])
  @@index([dealId, occurredAt])
}

model DealStageChange {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStageId String?
  toStageId   String
  changedById String?
  changedAt   DateTime @default(now())

  @@index([dealId])
}

/// Stops the worker from sending the same reminder twice.
model ReminderLog {
  id        String   @id @default(cuid())
  kind      String
  dealId    String
  key       String
  createdAt DateTime @default(now())

  @@unique([kind, dealId, key])
}

// ---------------------------------------------------------------------------
// IT catalog: Vendor -> Category (shared) -> Product -> Sub-product (hardware or software)
// Distributors sell vendors' products to Somtel. Costs never appear on client documents.
// ---------------------------------------------------------------------------

enum ItKind {
  HARDWARE
  SOFTWARE
}

model Vendor {
  id           String              @id @default(cuid())
  name         String              @unique
  website      String?
  notes        String?
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  products     ItProduct[]
  distributors VendorDistributor[]
}

model ItCategory {
  id        String      @id @default(cuid())
  name      String      @unique
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  products  ItProduct[]
}

model ItProduct {
  id          String         @id @default(cuid())
  vendorId    String
  vendor      Vendor         @relation(fields: [vendorId], references: [id])
  categoryId  String
  category    ItCategory     @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  subProducts ItSubProduct[]

  @@unique([vendorId, name])
  @@index([categoryId])
}

model ItSubProduct {
  id               String             @id @default(cuid())
  productId        String
  product          ItProduct          @relation(fields: [productId], references: [id])
  name             String
  sku              String?
  kind             ItKind
  // Text printed on the client quote.
  quoteDescription String?
  unitLabel        String?
  // Subscription length for software (used for renewals).
  termMonths       Int?
  // Null means use the default markup in settings for its kind.
  markupPct        Decimal?           @db.Decimal(7, 3)
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  costs            DistributorPrice[]
  dealLines        DealProduct[]

  @@unique([productId, name])
  @@index([sku])
}

model Distributor {
  id              String               @id @default(cuid())
  name            String               @unique
  country         String?
  currency        String               @default("USD")
  paymentTerms    String?
  remittanceNotes String?
  website         String?
  notes           String?
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  contacts        DistributorContact[]
  vendors         VendorDistributor[]
  costs           DistributorPrice[]
}

model DistributorContact {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  name          String
  title         String?
  phone         String?
  email         String?
  createdAt     DateTime    @default(now())
}

/// Which distributors carry which vendors (many to many).
model VendorDistributor {
  vendorId      String
  distributorId String
  vendor        Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  partnerLevel  String?
  accountNumber String?
  notes         String?
  createdAt     DateTime    @default(now())

  @@id([vendorId, distributorId])
}

/// Cost history: one row each time a distributor quotes a sub-product.
model DistributorPrice {
  id            String       @id @default(cuid())
  distributorId String
  distributor   Distributor  @relation(fields: [distributorId], references: [id])
  subProductId  String
  subProduct    ItSubProduct @relation(fields: [subProductId], references: [id])
  unitCost      Decimal      @db.Decimal(14, 4)
  currency      String
  // 1 USD = exchangeRate x currency. 1 for USD.
  exchangeRate  Decimal      @db.Decimal(14, 6)
  quotedAt      DateTime
  reference     String?
  notes         String?
  createdById   String?
  createdAt     DateTime     @default(now())

  @@index([subProductId, distributorId, quotedAt])
}

// ---------------------------------------------------------------------------
// System
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailOutbox {
  id        String      @id @default(cuid())
  to        String
  cc        String?
  subject   String
  html      String
  text      String?
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  sendAfter DateTime    @default(now())
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([status, sendAfter])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  APPROVE
  REJECT
  STAGE_CHANGE
  LOGIN
  LOGIN_FAILED
  PASSWORD_RESET
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String?
  summary    String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
