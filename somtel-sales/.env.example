# ---- Database ----
# Used by the app and worker. In Docker Compose the host is "db".
DATABASE_URL="postgresql://somtel:change-me@localhost:5432/somtel?schema=public"
POSTGRES_PASSWORD="change-me"

# ---- Auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Public address of the app (used in email links)
APP_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# ---- Email (SMTP) ----
SMTP_HOST=""
SMTP_PORT="587"
# "true" for port 465 (TLS), "false" for 587 (STARTTLS)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Somtel Enterprise <enterprise@example.com>"

# ---- Files ----
# Uploaded files (logo, contracts, POs). In Docker this is a volume.
UPLOAD_DIR="./data/uploads"

# ---- First admin (used by: npm run create-admin) ----
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="System Admin"
ADMIN_PASSWORD=""
